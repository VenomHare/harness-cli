{
  "name": "@venomhare/harness-cli",
  "version": "0.1.0",
  "description": "An interactive terminal AI agent built with Ink.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": { "bun": ">=1.4.0" },
  "files": ["dist/index.js", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VenomHare/harness-cli.git"
  },
  "bugs": { "url": "https://github.com/VenomHare/harness-cli/issues" },
  "homepage": "https://github.com/VenomHare/harness-cli#readme",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dotenv": "^8.2.3",
    "@types/react": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "typescript": "^7.0.2"
  },
  "bin": {
    "harness": "./dist/index.js"
  },
  "dependencies": {
    "@jescalan/ink-markdown": "^2.0.0",
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.5",
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^7.27.0",
    "react": "^19.3.0",
    "react-devtools-core": "^8.0.0",
    "uuid": "^14.0.2"
  },
  "scripts": {
    "dev": "bun src/index.tsx",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.tsx --bundle --target=bun --format=esm --outfile dist/index.js",
    "verify": "bun run typecheck && bun run build",
    "prepack": "bun run verify",
    "build:binary": "bun build src/index.tsx --compile --minify --outfile dist/harness",
    "build:binary:linux": "bun build src/index.tsx --compile --minify --target=bun-linux-x64 --outfile dist/harness-linux-x64",
    "build:binary:darwin-arm64": "bun build src/index.tsx --compile --minify --target=bun-darwin-arm64 --outfile dist/harness-darwin-arm64",
    "build:binary:darwin-x64": "bun build src/index.tsx --compile --minify --target=bun-darwin-x64 --outfile dist/harness-darwin-x64",
    "build:binary:windows-x64": "bun build src/index.tsx --compile --minify --target=bun-windows-x64 --outfile dist/harness-windows-x64.exe",
    "build:binary:all": "bun run build:binary:linux && bun run build:binary:darwin-arm64 && bun run build:binary:darwin-x64 && bun run build:binary:windows-x64"
  }
}
